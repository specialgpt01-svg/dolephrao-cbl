APP_NAME="LOFT LEARN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:5000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file

# ===== LOG =====
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== DATABASE =====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loft_learn
DB_USERNAME=root
DB_PASSWORD=

# ===== CACHE (Realtime-First — cache เฉพาะ global_settings / sources_list / leaderboard) =====
# Shared Hosting: ใช้ file cache (ไม่ต้องการ Redis)
CACHE_STORE=file
CACHE_PREFIX=loft

# ===== SESSION =====
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ===== QUEUE =====
# Shared Hosting: ใช้ sync (ไม่มี worker process)
QUEUE_CONNECTION=sync

# ===== FILE STORAGE =====
FILESYSTEM_DISK=local
# ถ้าใช้ S3/R2 ในอนาคต:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=
# AWS_URL=

# ===== MAIL (ถ้าต้องการส่ง Email) =====
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@loftlearn.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== GEMINI AI =====
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# ===== GOOGLE APPS SCRIPT (Legacy — จะตัดออกในอนาคต) =====
APPS_SCRIPT_URL=

# ===== SANCTUM (Laravel 12 / Sanctum 4) =====
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5000,localhost:5000
SANCTUM_GUARD=web

LOFT_ADMIN_PHONE=
LOFT_ADMIN_PASSWORD=
LOFT_ADMIN_NAME="ผู้ดูแลระบบ LOFT"

# ===== PRODUCTION OVERRIDES (ใช้ตอน deploy บน host จริง) =====
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://yourdomain.com
# LOG_LEVEL=error
# DB_HOST=localhost
# DB_DATABASE=cpanelusername_loft
# DB_USERNAME=cpanelusername_dbuser
# DB_PASSWORD=StrongPassword123!
